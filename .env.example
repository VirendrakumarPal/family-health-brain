# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=sk-ant-...
# Writer: the model that writes notes (Opus = best quality; set a Sonnet model to save cost)
WRITER_MODEL=claude-opus-5-5
# Filter: cheap model that decides keep/skip before the writer runs
FILTER_MODEL=claude-haiku-4-5
# Optional: use TypeSafe Jev as the filter for text inputs
USE_JEV=0
TYPESAFE_API_KEY=
